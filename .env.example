# Run `pnpm run setup`, or copy this file to .env and fill every required value.
# Must match your browser URL. HTTPS in production; HTTP only on localhost.
BETTER_AUTH_URL='http://localhost:3100'
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=''
# GitHub OAuth App callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=''
GITHUB_CLIENT_SECRET=''
GITHUB_ALLOWED_USERS=''
SCAN_INTERVAL_HOURS='6'
