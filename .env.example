# Run `pnpm run setup`, or copy this file to .env and set the URL and secret. OAuth providers are optional until you configure sign-in.
# Must match your browser URL. HTTPS in production; HTTP only on localhost.
BETTER_AUTH_URL='http://localhost:3100'
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=''
# Optional GitHub OAuth App callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=''
GITHUB_CLIENT_SECRET=''
# One GitHub username, not an email. Manage additional users in the web UI.
GITHUB_ADMIN_USER=''

# Google callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
# Microsoft callback: <BETTER_AUTH_URL>/api/auth/callback/microsoft
# Register for both personal accounts and accounts in any organization.
MICROSOFT_CLIENT_ID=''
MICROSOFT_CLIENT_SECRET=''
# Administrator email for Google and Microsoft.
AUTH_ADMIN_EMAIL=''
# Microsoft requires email delivery to verify mailbox ownership.
SMTP_URL=''
AUTH_EMAIL_FROM=''

# Optional fallback; prefer Settings > Coolify connection in the scanner.
# Saved in-app settings take precedence. Use a read-only API token.
KOPES_COOLIFY_URL=''
COOLIFY_API_TOKEN=''
