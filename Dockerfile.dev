# syntax=docker/dockerfile:1
FROM aquasec/trivy:0.76.1 AS trivy
FROM node:24.17.0-bookworm-slim
RUN apt-get update && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@10.8.0 \
    && mkdir /data /repo && chown 65532:65532 /data /repo
WORKDIR /repo
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY --chown=65532:65532 package.json pnpm-lock.yaml ./
USER 65532:65532
RUN pnpm install --frozen-lockfile --store-dir /repo/.pnpm-store
COPY --chown=65532:65532 . ./
ENV NODE_ENV=development DATA_DIR=/data HOST_ROOT=/host TMPDIR=/data/tmp
EXPOSE 3100
CMD ["node", "node_modules/vite/bin/vite.js", "dev", "--host", "0.0.0.0", "--port", "3100", "--strictPort"]
